class Askme < Formula
  desc "AskMe: a shared local AI command planner for the shell"
  homepage "https://github.com/hangyuRen/AskMe"
  url "REPLACE_WITH_PUBLISHED_NPM_TARBALL_URL"
  sha256 "REPLACE_WITH_TARBALL_SHA256"
  license "MIT"

  depends_on "node"

  def install
    system "npm", "install", *std_npm_args
    bin.install_symlink libexec.glob("bin/*")
  end

  test do
    assert_match "Usage:", shell_output("#{bin}/ask --help")
  end
end
